[Unit]
Description=Nightly local CI of retro-blocks: just nightly, tier L3 (#36, skill local-ci), on a clean origin/main worktree (#42)
OnFailure=retro-blocks-nightly-failed.service

[Service]
Type=oneshot
# The user manager's PATH has no ~/.local/bin, where mise lives; mise brings the pinned tools.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=REPO=%h/Documents/02_personal/video_games/retro-blocks WT=%h/.cache/nightly/retro-blocks
# Never the working checkout: it may be dirty, on a feature branch or behind origin/main
# (agents-skills#427). '-': a catch-up run before the network is up uses the last fetched origin/main
# (pnpm audit still needs the registry: offline, the run fails). The prune drops a registration
# left by a deleted cache, which would make `worktree add` refuse.
ExecStartPre=-/usr/bin/git -C ${REPO} fetch --quiet origin main
ExecStartPre=/bin/sh -c 'test -d "$WT" || { git -C "$REPO" worktree prune && git -C "$REPO" worktree add --detach "$WT" origin/main; }'
ExecStartPre=/usr/bin/git -C ${WT} reset --quiet --hard origin/main
ExecStartPre=/usr/bin/git -C ${WT} clean -ffdq
ExecStartPre=%h/.local/bin/mise trust --quiet ${WT}
ExecStartPre=/bin/sh -c 'cd "$WT" && exec mise x -- pnpm install --frozen-lockfile --ignore-scripts'
ExecStart=/bin/sh -c 'cd "$WT" && exec mise x -- just nightly'
# A oneshot has no timeout: a hung fetch would block the timer for good.
TimeoutStartSec=2h
